{
  "solver": "CasADi nlpsol IPOPT",
  "solver_class": "ShipCasadiMPC via CasadiReferenceGenerator",
  "N": 6,
  "mpc_horizon": 6,
  "decision_variable_length": 6,
  "p_fc_decision_length": 6,
  "p_batt_decision_length": 6,
  "soc_state_length": 7,
  "soc_prediction_steps": 6,
  "p_batt_abs_decision_length": 6,
  "total_nlp_variable_length": 25,
  "objective_loop_range": "0..5",
  "uses_stages": [
    0,
    1,
    2,
    3,
    4,
    5
  ],
  "uses_stage_0_to_5": true,
  "returns_only_first_control": true,
  "returned_control_fields": [
    "fuel_cell_ref_kw",
    "battery_ref_kw",
    "predicted_soc"
  ],
  "forecast_parameter_length": 6,
  "control_timing": "one_step_ahead_lstm_mpc",
  "control_apply_timing": "execute_cached_previous_mpc_command",
  "fuel_cell_ramp_constraint_enabled": false,
  "objective_mode": "raw_physical",
  "use_h2_mass_cost": true
}
